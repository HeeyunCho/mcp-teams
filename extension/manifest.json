{
  "manifest_version": 3,
  "key": "",
  "name": "mcp-teams bridge",
  "version": "0.3.20",
  "description": "Lets AI assistants (via the mcp-teams MCP server) read and search Microsoft Teams chats, channels and meeting transcripts and, with your explicit confirmation, post messages.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://teams.cloud.microsoft/*",
    "https://teams.microsoft.com/*",
    "https://*.ng.msg.teams.microsoft.com/*",
    "https://substrate.office.com/*",
    "https://*.cloud.microsoft/*",
    "https://*.microsoft.com/*",
    "https://*.office.com/*",
    "https://*.office.net/*",
    "https://*.sharepoint.com/*",
    "https://*.svc.ms/*",
    "https://*.skype.com/*"
  ],
  "action": {
    "default_title": "mcp-teams",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  }
}
